{
  "game": "PARRY",
  "schema_version": 1,
  "notes": [
    "cost means MANA for UNIT and SPELL cards, and GUARD for RESPONSE cards.",
    "effect is the authoritative machine-readable string. modes[] is a pre-parsed convenience mirror for RESPONSE cards; engines may parse effect and ignore modes.",
    "There is no neutral pool. Every card is faction-locked. This is deliberate: the study measured Gini 0.736 at peak neutral auto-include concentration."
  ],
  "effect_grammar": {
    "unit_spell": "[<TRIGGER>>]<stmt>[;<stmt>]*",
    "response": "RESPONSE|<Label>@<WINDOWS>><stmt>[;<stmt>]*|<Label>@<WINDOWS>><stmt>[;<stmt>]*",
    "triggers": ["ARRIVAL", "FALL", "TURN_END", "FUSE"],
    "windows": ["CAST", "DEPLOY", "STRIKE", "END", "ANY"],
    "verbs": [
      "NONE",
      "TARGET:<selector>",
      "DEAL:<n>:<selector>",
      "HEAL:<n>:<selector>",
      "ARMOR:<n>",
      "DRAW:<n>",
      "SUMMON:<atk>/<hp>:<Name>[:<KW>[,<KW>]]",
      "BUFF:<atk>/<hp>:<selector>",
      "GRANT:<KEYWORD>:<selector>",
      "DESTROY:<selector>",
      "RETURN:<selector>",
      "STUN:<selector>",
      "GAIN_GUARD:<n>",
      "REFRESH_ATTACKS:<selector>",
      "COUNTER",
      "CANCEL_ATTACK"
    ],
    "selectors": [
      "T", "TRIGGER", "SELF",
      "UNIT", "ALLY_UNIT", "ENEMY_UNIT", "ANY",
      "ENEMY_HERO", "SELF_HERO",
      "ALL_UNITS", "ALL_ALLY_UNITS", "ALL_ENEMY_UNITS",
      "RANDOM_ENEMY_UNIT"
    ]
  },
  "keywords": [
    {
      "name": "Bulwark",
      "rules_text": "Enemy units must attack this first.",
      "why_it_earns_a_slot": "Without a blocker keyword the STRIKE window is the only defensive tool in the game and combat has no geometry. Bulwark is what makes choosing NOT to fire your Response survivable."
    },
    {
      "name": "Swift",
      "rules_text": "May attack the turn it arrives. That attack cannot hit the enemy hero.",
      "why_it_earns_a_slot": "Gives the proactive deck immediate board impact without giving it uninteractive face burst, and it is the main reason the DEPLOY window is worth spending a Response on."
    },
    {
      "name": "Ward",
      "rules_text": "Ignores the first damage it would take.",
      "why_it_earns_a_slot": "It is the cheapest tax on small damage Responses. A 2-damage Response mode stops being a free answer, so the defender must choose modes rather than reflex-firing."
    },
    {
      "name": "Sealed",
      "rules_text": "Playing this opens no response window.",
      "why_it_earns_a_slot": "The pressure valve. Without an unanswerable subset, a fully armed defender makes every key play a coinflip. Sealed lets the aggressor buy certainty at a stat discount, and it is the single most important counter-lever the attacker has."
    },
    {
      "name": "Fuse",
      "rules_text": "Resolves at the start of your next turn.",
      "why_it_earns_a_slot": "Option 7 of the study, shipped as a safety net exactly as recommended. Effects too big to be answered by one card are instead telegraphed a full turn early, so the prototype never needs an unanswerable haymaker."
    }
  ],
  "tokens": [
    { "name": "Outrider", "attack": 2, "health": 2, "keywords": ["Bulwark"] },
    { "name": "Sentry", "attack": 3, "health": 3, "keywords": ["Bulwark"] }
  ],
